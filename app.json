{
  "expo": {
    "name": "Activities",
    "slug": "activity-tracker",
    "version": "3.7.0",
    "icon": "./assets/icon.png",
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pavelpotocek.activitytracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-fg.png",
        "backgroundColor": "#7166ff"
      },
      "package": "com.pavelpotocek.activitytracker",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "098bd04a-6ecb-4bf9-89b7-d050163640db"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-localization",
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-fg.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/icon-fg.png",
            "backgroundColor": "#222222"
          }
        }
      ],
      [
        "./WithAbiFilters",
        {
          "abiFilters": ["arm64-v8a", "armeabi-v7a"]
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["peripheral","central"],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to bluetooth devices"
        }
      ]
    ]
  }
}
