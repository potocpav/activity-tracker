{
  "name": "activity-tracker",
  "version": "3.8.2",
  "main": "expo/AppEntry.js",
  "scripts": {
    "dev": "APP_VARIANT=development npx expo start",
    "build-dev": "eas build --platform android --profile development --local",
    "build-preview": "eas build --platform android --profile preview --local",
    "build-production": "eas build --platform android --local",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-screen-capture": "~58.0.6",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-actions-sheet": "^0.9.7",
    "react-native-ble-plx": "^3.5.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "fast-check": "^4.10.0",
    "patch-package": "^8.0.1",
    "prettier": "3.9.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
